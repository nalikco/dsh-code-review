{
  "name": "dsh-code-review",
  "version": "1.3.0",
  "private": true,
  "description": "A native code-review skill for DeepSeek Harness with a slash invocation and optional fixes.",
  "type": "module",
  "license": "MIT",
  "author": "Igor Karpliuk",
  "repository": { "type": "git", "url": "git+https://github.com/nalikco/dsh-code-review.git" },
  "homepage": "https://github.com/nalikco/dsh-code-review#readme",
  "bugs": { "url": "https://github.com/nalikco/dsh-code-review/issues" },
  "keywords": ["deepseek-harness", "dsh", "cordis", "code-review", "refactoring"],
  "icon": "./icon.svg",
  "main": "./index.mjs",
  "engines": { "node": ">=22", "dsh": "^0.2.0-rc.2" },
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.mjs", "options.mjs", "prompt.mjs", "REVIEW_PROMPT.md", "cordis.patch.yml", "icon.svg", "locale/*.json", "README.md", "README.ru.md", "SECURITY.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:all": "npm test",
    "test:package": "node scripts/check-package.mjs"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.1"
  }
}
