{
  "name": "dsh-code-review",
  "version": "1.0.2",
  "private": true,
  "description": "Read-only multi-angle code review with independently validated, policy-preserving fix handoff for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "Igor Karpliuk",
  "repository": { "type": "git", "url": "git+https://github.com/nalikco/dsh-code-review.git" },
  "homepage": "https://github.com/nalikco/dsh-code-review#readme",
  "bugs": { "url": "https://github.com/nalikco/dsh-code-review/issues" },
  "keywords": ["deepseek-harness", "dsh", "cordis", "code-review", "refactoring"],
  "icon": "./icon.svg",
  "main": "./index.mjs",
  "engines": { "node": ">=22" },
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs", "engine.mjs", "findings.mjs", "fix.mjs", "git.mjs",
    "options.mjs", "prompts.mjs", "runner.mjs", "workspace.mjs", "services.mjs",
    "cordis.patch.yml", "icon.svg", "locale/*.json", "README.md", "README.ru.md", "SECURITY.md", "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test integration/*.test.mjs",
    "test:all": "npm test && npm run test:integration",
    "test:package": "node scripts/check-package.mjs"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.0-rc.2"
  }
}
